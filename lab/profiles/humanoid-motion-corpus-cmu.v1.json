  "retarget": {
    "algorithm_id": "nextengine.cmu-asf-to-biomechanics-v1",
    "sample_rule": "inclusive source crop, then source frames 1,3,5,... relative to crop start",
    "joint_quantization": "nearest-ties-to-even microradians",
    "translation_quantization": "nearest-ties-to-even micrometres",
    "rotation_quantization": "canonical-sign nearest-ties-to-even Q1.30",
    "soft_rom_policy": "clamp after explicit semantic source-to-target solve",
    "velocity_policy": "causal projection to each target joint maximum velocity at 60 Hz after soft-ROM projection",
    "locomotion_collision_projection": {
      "hip_yaw_microradians": 0,
      "hip_roll_minimum_microradians": 0,
      "ankle_pitch_minimum_microradians": -349066,
      "ankle_roll_minimum_microradians": -87266,
      "ankle_roll_maximum_microradians": 87266,
      "ankle_roll_minimum_hard_reserve_microradians": 261800,
      "ankle_roll_maximum_soft_boundary_fraction": 0.0,
      "shoulder_roll_minimum_microradians": 261799,
      "rationale": "keep nominal locomotion thighs separated and arms outside torso/pelvis colliders; keep ankle plantarflexion at least 20 degrees inside its hard limit; confine ankle roll to plus or minus 5 degrees so every locomotion reference retains at least 15 degrees of hard-limit reserve, exceeding the 11.33-degree reference-to-peak transient measured in TRAIN-5 by 32 percent; reject any final ankle-roll sample on a descriptor soft boundary; every applied projection is retained per frame and channel"
    },
    "ground_correction": {
      "algorithm": "signed vertical alignment: sole collider for locomotion, minimum solid collider for recovery",
      "locomotion_maximum_absolute_micrometres": 125000,
      "recovery_maximum_absolute_micrometres": 650000
    },
    "contact_thresholds": {
      "sole_height_micrometres": 45000,
      "sole_speed_micrometres_per_second": 600000,
      "recovery_height_micrometres": 55000,
      "recovery_speed_micrometres_per_second": 600000
    },
    "loop_pose_max_microradians": 200000,
    "loop_velocity_max_microradians_per_second": 800000,
    "mirror_rule": "BodySchema symmetry pairs plus sagittal X reflection"
  },
  "coverage_requirements": {
    "required_splits": ["train", "validation", "heldout"],
    "minimum_independent_groups_per_split": 1,
    "classes": {
      "neutral_balance": {"required_skills": ["neutral_idle", "weight_shift"]},
      "start": {"required_skills": ["start_left_lead", "start_right_lead"]},
      "walk_slow": {"required_skills": ["walk_slow_forward"], "minimum_full_gait_cycles_per_split_group": 4},
